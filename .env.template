# Copy to .env (gitignored). `npm run executor` passes it to the executor, and `npm start` to design.mjs.
# This kit needs your own Anthropic API key: IMG.LY's AI gateway does not serve the Claude Agent SDK's API (Anthropic's Messages API).

# Your CoDesign license key. The executor uses it for the engine and the exports.
IMGLY_CESDK_LICENSE=

# The token the executor and design.mjs share. It works as it is.
EXECUTOR_TOKEN=codesign-quickstart-token

# Your Anthropic API key, for the model (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=

# Optional: the Claude model (default claude-opus-5), for example claude-sonnet-5.
# MODEL=claude-sonnet-5

# Optional: the executor's address (default http://localhost:8080).
# EXECUTOR_URL=http://localhost:8080
